# Copy to .env and fill in what you have. Restart the server after editing.

# Port / host for the web server (HOST=0.0.0.0 to reach it from a phone)
PORT=3000
HOST=127.0.0.1

# Password for the whole site – set it whenever the app is reachable from outside
APP_PASSWORD=

# The Odds API – odds from dozens of bookmakers (free: 500 requests/month)
# https://the-odds-api.com
ODDS_API_KEY=

# How long to cache The Odds API responses (minutes) – protects the free quota
ODDS_API_TTL_MIN=30

# API-Football – Bet365 football odds (free: 100 requests/day)
# https://www.api-football.com
APIFOOTBALL_KEY=

# TheSportsDB premium key – full live scores for Israeli leagues / EuroLeague,
# higher rate limit. Leave empty to use the free test key.
THESPORTSDB_KEY=

# Default weight of the statistical model vs the de-vigged market (0..1)
MODEL_WEIGHT=0.3
