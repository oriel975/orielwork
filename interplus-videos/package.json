{
  "name": "interplus-videos",
  "version": "0.1.0",
  "private": true,
  "description": "Interplus group marketing videos (Remotion, Hebrew RTL), driven by JSON scene files in src/videos.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/build-manifest.mjs",
    "manifest": "node scripts/build-manifest.mjs",
    "studio": "node scripts/build-manifest.mjs && remotion studio",
    "render": "node scripts/render.mjs",
    "render:all": "node scripts/render.mjs --all",
    "render:style-test": "node scripts/render.mjs style-test",
    "render:installations": "node scripts/render.mjs --company=installations",
    "render:ev": "node scripts/render.mjs --company=ev",
    "render:enerlec": "node scripts/render.mjs --company=enerlec",
    "stills": "node scripts/render.mjs --stills",
    "logo-colors": "node scripts/sample-logo-colors.mjs",
    "placeholders": "node scripts/make-placeholders.mjs",
    "typecheck": "tsc --noEmit",
    "deliver": "node scripts/deliver.mjs"
  },
  "dependencies": {
    "@fontsource/heebo": "5.2.8",
    "@remotion/bundler": "4.0.542",
    "@remotion/cli": "4.0.542",
    "@remotion/fonts": "4.0.542",
    "@remotion/media-utils": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "remotion": "4.0.542"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/webpack-env": "1.18.8",
    "mediabunny": "1.64.0",
    "sharp": "0.34.5",
    "typescript": "5.9.3"
  }
}
